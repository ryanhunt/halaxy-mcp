# Halaxy API credentials (from Halaxy's developer portal - create an API key
# under Settings > API Keys, then copy its client_id/client_secret here).
HALAXY_CLIENT_ID=
HALAXY_CLIENT_SECRET=

# Defaults to https://au-api.halaxy.com/main - override for EU/UK practices
# HALAXY_API_BASE=https://eu-api.halaxy.com/main

# Only used when MCP_TRANSPORT=http (Docker deployment) - a shared secret
# remote MCP clients must send as "Authorization: Bearer <token>".
# Generate one with `openssl rand -hex 32`. Unrelated to HALAXY_CLIENT_SECRET
# above (that's this server's credential *to* Halaxy, not from its callers).
MCP_SERVER_TOKEN=
