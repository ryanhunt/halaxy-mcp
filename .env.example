# Halaxy API credentials (from Halaxy's developer portal - create an API key
# under Settings > API Keys, then copy its client_id/client_secret here).
HALAXY_CLIENT_ID=
HALAXY_CLIENT_SECRET=

# Defaults to https://au-api.halaxy.com/main - override for EU/UK practices
# HALAXY_API_BASE=https://eu-api.halaxy.com/main

# Only used when MCP_TRANSPORT=http (Docker deployment). Claude's/Copilot's
# connector setup requires real OAuth, not a static token - this server acts
# as its own minimal OAuth authorization server, and these are the
# credentials its login page checks. One shared login is fine for a small
# practice; pick a strong password.
MCP_LOGIN_USERNAME=
MCP_LOGIN_PASSWORD=

# Hostnames a newly-registered OAuth client's redirect_uri is allowed to
# point at, comma-separated. Dynamic Client Registration is open (every
# MCP client needs to self-register with no prior setup), which otherwise
# lets anyone register their own client with an attacker-controlled
# redirect_uri and phish your shared login password. Leave unset only
# while first getting a deployment working; set it before treating a
# deployment as done - add ONLY the hosts for AI services you actually
# intend to connect, not every one listed below.
#
# Confirmed live hosts, one per AI service - add the ones you use:
#   Claude (claude.ai custom connector)         -> claude.ai
#   ChatGPT (chatgpt.com connector)              -> chatgpt.com
#   Microsoft 365 Copilot (via Copilot Studio)   -> global.consent.azure-apim.net
#     (registers under the client name "Credential Manager" - this is
#     Microsoft's own Power Platform OAuth consent host, not something
#     you configure yourself)
#   OpenAI Codex CLI (or any other native/CLI MCP client using the
#   RFC 8252 loopback pattern)                   -> 127.0.0.1
#     (matched by hostname only, so every random port Codex picks across
#     sessions is covered by this one entry - no need to track ports)
#
# If you connect something not in that list, find its real host by
# checking this server's own logs right after it tries to connect
# (`docker compose -f docker-compose.pi.yml logs halaxy-mcp | grep register`)
# - the registered redirect_uri is right there in a successful
# `POST /register` response, so there's no need to guess.
#
# Once you've connected your real clients, cross-check what actually
# registered against `oauth_state.json`:
#   python3 -c "import json; d=json.load(open('oauth_state.json')); \
#     [print(c.get('client_name'), '->', c['redirect_uris'][0]) for c in d['clients'].values()]"
#
# If a client connected before this setting existed, it may have cached a
# client_id from before and skip re-registering (you'll see its /authorize
# request 400 with "Client ID '...' not found", with no matching
# /register call before it in the logs) - disconnect and reconnect that
# client from its own settings to force it to register fresh.
MCP_ALLOWED_REDIRECT_URI_HOSTS=

# The public HTTPS URL remote clients actually reach this server at (behind
# Caddy on a real deployment) - used as the OAuth issuer/redirect base. NOT
# the same as MCP_HOST/MCP_PORT (which control what the container binds to
# internally). For local testing without TLS: http://127.0.0.1:8000.
# MCP_PUBLIC_URL=https://your-domain.example.com
